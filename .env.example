APP_NAME="Order Saif"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://OrderSaif.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=30

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ordersaif_prod
DB_USERNAME=ordersaif_user
DB_PASSWORD=your_secure_password_here

# Session Configuration (Wildcard Subdomains Support & 60-Day Lifetime)
# Note: The dot (.) prefix is crucial to share sessions across wildcard subdomains (e.g., store1.ordersaif.com, store2.ordersaif.com)
SESSION_DRIVER=redis
SESSION_LIFETIME=86400
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ordersaif.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache & Queue Configuration for Production
# Using Redis is highly recommended for production performance and stability
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Cache Prefix to prevent collisions in shared Redis environments
CACHE_PREFIX=fast_order_cache_

MEMCACHED_HOST=127.0.0.1

# Redis settings
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production Mail Settings
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@OrderSaif.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Settings (If using S3 for storage in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend variables
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# SSL and Security settings
FORCE_HTTPS=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
